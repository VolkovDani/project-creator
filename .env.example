# Replace both placeholders before starting. Keep .env out of version control.
# Use separate random hex values (openssl rand -hex 24) to avoid URL escaping.
APP_PORT=3000
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=5432
PROJECT_CREATOR_DATABASE_URL=postgresql://project_creator:replace-with-a-random-password@127.0.0.1:5432/project_creator?sslmode=disable
PROJECT_CREATOR_TOKEN=replace-with-a-random-token-of-at-least-32-characters

# Optional local embeddings. Leave these unset to disable model calls.
# PROJECT_CREATOR_OLLAMA_URL=http://127.0.0.1:11434
# Role URLs can point at separate local Ollama instances; otherwise each uses OLLAMA_URL.
# PROJECT_CREATOR_EMBEDDING_URL=http://127.0.0.1:11434
# PROJECT_CREATOR_GENERATOR_URL=http://127.0.0.1:11434
# PROJECT_CREATOR_EMBEDDING_MODEL=bge-m3:567m
# PROJECT_CREATOR_EMBEDDING_DIGEST=sha256:replace-with-full-digest-from-ollama-api-tags

# Optional local single-record classification. Choose one profile for manual review of both axes.
# PROJECT_CREATOR_RECORD_CLASSIFIER=laya-review
# PROJECT_CREATOR_RECORD_CLASSIFIER=d3-review
# PROJECT_CREATOR_RECORD_CLASSIFIER_URL=http://127.0.0.1:11434

# Optional local generation model for explicit requirement analysis.
# PROJECT_CREATOR_GENERATOR_MODEL=qwen2.5:7b
# PROJECT_CREATOR_GENERATOR_DIGEST=sha256:replace-with-full-digest-from-ollama-api-tags

# Initial threshold for related-pair analysis, from 0 to 1 inclusive.
# Empty/unset uses 0.65. Recreate the backend after changing this value.
# PROJECT_CREATOR_ANALYSIS_DEFAULT_THRESHOLD=0.8

# Ollama loaded-model capacity. Set to 2 or 3 when roles use distinct models
# and sufficient RAM/VRAM is available; default 1 preserves existing behavior.
# OLLAMA_MAX_LOADED_MODELS=2

# Optional Intel Arc or AMD Vulkan numeric device selection (compose.intel.yml /
# compose.amd-vulkan.yml). Never use a ROCm UUID here.
# Leave unset for automatic discovery; use an ID from Ollama's Vulkan logs.
# GGML_VK_VISIBLE_DEVICES=0



# Optional experimental host NPU runtime. See docs/intel-npu.md.
# compose.npu.yml selects openvino-npu; ordinary Compose remains Ollama.
# PROJECT_CREATOR_NPU_PROFILE=full-lowercase-manifest-sha256
# NPU_SOCKET_DIR=/absolute/path/to/project-creator/.npu/run
# NPU_SOCKET_GID=1000
# Direct host backend only:
# PROJECT_CREATOR_GENERATOR_RUNTIME=openvino-npu
# PROJECT_CREATOR_NPU_SOCKET=/absolute/path/to/project-creator/.npu/run/runtime.sock

# Optional manual NVIDIA/AMD ROCm selection. CLI persists its own authoritative selection.
# PROJECT_CREATOR_GPU_ID=GPU-full-uuid

# Optional automatic previews and Laya input; explicitly pin a local generative model.
# PROJECT_CREATOR_SUMMARY_URL=http://127.0.0.1:11434
# Allowed output languages; empty/unset means ru,en. Restart backend after changes.
PROJECT_CREATOR_SUMMARY_LANGUAGES=ru,en
# PROJECT_CREATOR_SUMMARY_MODEL=qwen2.5:7b
# PROJECT_CREATOR_SUMMARY_DIGEST=sha256:replace-with-full-digest-from-ollama-api-tags
