{
  "name": "project-creator-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "bun --bun next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "codegen": "node codegen.ts",
    "e2e": "playwright test",
    "prebuild": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ux": "playwright test --config ux.playwright.config.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint:ci": "biome ci .",
    "hooks:install": "node ../scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "graphql": "17.1.0",
    "markdown-to-jsx": "9.10.6",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sugar-high": "2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@graphql-codegen/core": "7.0.0",
    "@graphql-codegen/typed-document-node": "8.0.0",
    "@graphql-codegen/typescript-operations": "7.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "type": "module"
}
