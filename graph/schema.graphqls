type Project { id: ID! name: String! goal: String! description: String! createdAt: String! updatedAt: String! }
input ProjectInput { name: String! goal: String! description: String! }
type FieldError { path: [String!]! code: String! messageKey: String! params: [ErrorParam!]! }
type ErrorParam { key: String! value: Int! }
type CreateProjectPayload { project: Project fieldErrors: [FieldError!]! }
type Requirement { id: ID! projectId: ID! text: String! version: Int! createdAt: String! updatedAt: String! }
input CreateRequirementInput { projectId: ID! text: String! }
input UpdateRequirementInput { id: ID! projectId: ID! version: Int! text: String! }
type RequirementPayload { requirement: Requirement fieldErrors: [FieldError!]! }
type DeleteRequirementPayload { deleted: Boolean! }
type PageInfo { endCursor: String hasNextPage: Boolean! }
type ProjectEdge { cursor: String! node: Project! }
type RequirementEdge { cursor: String! node: Requirement! }
type AnalysisPairEdge { cursor: String! node: AnalysisPair! }
type ProjectConnection { edges: [ProjectEdge!]! pageInfo: PageInfo! totalCount: Int! }
type RequirementConnection { edges: [RequirementEdge!]! pageInfo: PageInfo! totalCount: Int! }
type AnalysisPairConnection { edges: [AnalysisPairEdge!]! pageInfo: PageInfo! totalCount: Int! }
type ClassificationAlternative { semanticType: String! representationType: String! score: Float }
type RequirementClassification { requirementId: ID! textVersion: Int! revision: Int! status: String! semanticType: String! representationType: String! source: String! rulesVersion: String! model: String! createdAt: String! alternatives: [ClassificationAlternative!]! }
input ConfirmClassificationInput { projectId: ID! requirementId: ID! textVersion: Int! revision: Int! semanticType: String! representationType: String! }
type ClassificationPayload { classification: RequirementClassification fieldErrors: [FieldError!]! }
type GlossaryTermsPage { items: [GlossaryTerm!]! pageInfo: PageInfo! }
type GlossaryMatchesPage { items: [GlossaryCandidate!]! pageInfo: PageInfo! }
type GlossaryMentionPage { items: [Requirement!]! pageInfo: PageInfo! }
type Query { analysisDefaultThreshold: Float! glossaryTermsByIds(projectId: ID! ids: [ID!]!): [GlossaryTerm!]! glossaryMentions(projectId: ID! termId: ID! first: Int after: String): GlossaryMentionPage! glossaryTermsConnection(projectId: ID! search: String! first: Int after: String): GlossaryTermsPage! glossaryCandidatesConnection(projectId: ID! first: Int after: String): GlossaryMatchesPage! requirementClassification(projectId: ID! requirementId: ID!): RequirementClassification requirementClassificationHistory(projectId: ID! requirementId: ID! limit: Int! offset: Int!): [RequirementClassification!]! classifiedRequirements(projectId: ID! semanticType: String representationType: String limit: Int! offset: Int!): [RequirementClassification!]!  glossaryCandidates(projectId: ID! limit: Int! offset: Int!): GlossaryCandidatePage!  glossaryTerms(projectId: ID! search: String! limit: Int! offset: Int!): [GlossaryTerm!]! requirementGlossary(projectId: ID! analysisId: ID requirementId: ID! version: Int!): RequirementGlossary  failedRequirementSummaryCount(projectId: ID!): Int! requirementSummariesByIds(projectId: ID! requirementIds: [ID!]!): [RequirementSummary!]!  requirementIndexProgress(projectId: ID!): RequirementIndexProgress! projectAnalysis(projectId: ID! analysisId: ID): ProjectAnalysis projectAnalysisSummary(projectId: ID! analysisId: ID): ProjectAnalysisSummary analysisRunMetadata(projectId: ID! analysisId: ID!): AnalysisRunMetadata analysisPair(projectId: ID! analysisId: ID! pairId: ID!): AnalysisPair analysisPairs(projectId: ID! analysisId: ID! limit: Int! offset: Int! status: String! verdict: String!): [AnalysisPair!]! analysisPairsConnection(projectId: ID! analysisId: ID! first: Int after: String status: String verdict: String): AnalysisPairConnection! analysisHistory(projectId: ID! limit: Int! offset: Int!): [ProjectAnalysis!]! requirementIndex(projectId: ID! limit: Int! offset: Int!): [RequirementIndex!]! requirementIndexByIds(projectId: ID! requirementIds: [ID!]!): [RequirementIndex!]! searchRequirements(projectId: ID! text: String! limit: Int!): [RequirementSearchHit!]!  requirements(projectId: ID! limit: Int! offset: Int!): [Requirement!]! requirementsConnection(projectId: ID! first: Int after: String): RequirementConnection! project(id: ID!): Project projects(limit: Int! offset: Int!): [Project!]! projectsConnection(first: Int after: String): ProjectConnection! }
type Mutation { suggestGlossaryDefinition(input: SuggestGlossaryDefinitionInput!): GlossaryDefinitionSuggestion! confirmRequirementClassification(input: ConfirmClassificationInput!): ClassificationPayload!  saveGlossaryTerm(input: GlossaryInput!): GlossaryPayload! deleteGlossaryTerm(projectId: ID! id: ID! version: Int!): DeleteGlossaryPayload!  retryFailedRequirementSummaries(projectId: ID!): Int! retryRequirementSummary(projectId: ID! requirementId: ID!): RequirementSummary! cancelRequirementSummary(projectId: ID! requirementId: ID!): RequirementSummary!  replaceProjectAnalysis(projectId: ID! analysisId: ID! mode: String threshold: Float strategy: String!): ProjectAnalysis!  cancelProjectAnalysis(projectId: ID! analysisId: ID!): ProjectAnalysis! retryProjectAnalysis(projectId: ID! analysisId: ID!): ProjectAnalysis! startProjectAnalysis(projectId: ID! mode: String threshold: Float): ProjectAnalysis!  indexRequirement(projectId: ID! requirementId: ID!): RequirementIndex!  createRequirement(input: CreateRequirementInput!): RequirementPayload! updateRequirement(input: UpdateRequirementInput!): RequirementPayload! deleteRequirement(id: ID! projectId: ID! version: Int!): DeleteRequirementPayload!  createProject(input: ProjectInput!): CreateProjectPayload! }


type RequirementIndex { requirementId: ID! projectId: ID! version: Int! status: String! profile: String! errorCode: String! }
type RequirementSearchHit { requirementId: ID! projectId: ID! text: String! sourceText: String! version: Int! start: Int! end: Int! score: Float! }

type AnalysisSource { id: ID! version: Int! text: String! }
type AnalysisFinding { leftId: ID! rightId: ID! leftVersion: Int! rightVersion: Int! verdict: String! explanation: String! }
type AnalysisPair { explanationMatches: [GlossaryMatch!]! detailsVersion: String! isExactDuplicate: Boolean! layaErrorCode: String! layaStatus: String! preclassification: String layaCheckedAt: String selectionReasons: [String!]! similarityScore: Float resultOrigin: String! reusedFrom: ID! checkedAt: String! generatorProfile: String! id: ID! position: Int! status: String! left: AnalysisSource! right: AnalysisSource! verdict: String! explanation: String! errorCode: String! }
type ProjectAnalysis { classifierProfile: String! layaPendingPairs: Int! layaRunningPairs: Int! layaCompletedPairs: Int! layaFailedPairs: Int! layaSkippedPairs: Int! revision: String! mode: String! similarityThreshold: Float! selectionProfile: String! possiblePairs: Int notSelectedPairs: Int duplicatePairs: Int! reusedPairs: Int! newPairs: Int! completedPairs: Int! pendingPairs: Int! runningPairs: Int! failedPairs: Int! collisionPairs: Int! compatiblePairs: Int! insufficientPairs: Int! generatorProvenance: String! stage: String! totalPairs: Int processedPairs: Int! activePairId: ID! pairs: [AnalysisPair!]! reasonCode: String! missingRequirementIds: [ID!]! id: ID! projectId: ID! status: String! outcome: String! errorCode: String! createdAt: String! completedAt: String! stale: Boolean! generatorProfile: String! embeddingProfile: String! sources: [AnalysisSource!]! findings: [AnalysisFinding!]! }

type RequirementIndexProgress { projectId: ID! total: Int! queued: Int! running: Int! ready: Int! failed: Int! profile: String! configured: Boolean! }

type AnalysisRunMetadata { id: ID! projectId: ID! generatorProfile: String! generatorProvenance: String! embeddingProfile: String! selectionProfile: String! }

type ProjectAnalysisSummary { classifierProfile: String! layaPendingPairs: Int! layaRunningPairs: Int! layaCompletedPairs: Int! layaFailedPairs: Int! layaSkippedPairs: Int! revision: String! mode: String! similarityThreshold: Float! possiblePairs: Int notSelectedPairs: Int duplicatePairs: Int! reusedPairs: Int! newPairs: Int! completedPairs: Int! pendingPairs: Int! runningPairs: Int! failedPairs: Int! collisionPairs: Int! compatiblePairs: Int! insufficientPairs: Int! stage: String! totalPairs: Int processedPairs: Int! activePairId: ID! reasonCode: String! missingRequirementIds: [ID!]! id: ID! projectId: ID! status: String! outcome: String! errorCode: String! createdAt: String! completedAt: String! stale: Boolean! }

type RequirementSummary { glossaryMatches: [GlossaryMatch!]! byteLength: Int! layaEligible: Boolean! requirementId: ID! projectId: ID! version: Int! status: String! text: String! profile: String! provenance: String! createdAt: String! errorCode: String! }

type GlossaryVariant { text: String! kind: String! }
input GlossaryVariantInput { text: String! kind: String! }
input SuggestGlossaryDefinitionInput { projectId: ID! sourceId: ID! sourceVersion: Int! start: Int! end: Int! name: String! }
type GlossaryDefinitionSuggestion { definition: String status: String! fieldErrors: [FieldError!]! }
input GlossaryInput { projectId: ID! id: ID version: Int name: String! definition: String! context: String! variants: [GlossaryVariantInput!]! sourceId: ID sourceVersion: Int }
type GlossaryTerm { id: ID! name: String! definition: String! context: String! variants: [GlossaryVariant!]! version: Int! sourceId: ID! sourceVersion: Int! createdAt: String! updatedAt: String! }
type GlossaryPayload { term: GlossaryTerm fieldErrors: [FieldError!]! }
type DeleteGlossaryPayload { deleted: Boolean! }
type GlossaryMatch { start: Int! end: Int! text: String! terms: [GlossaryTerm!]! }
type GlossaryCandidatePage { items: [GlossaryCandidate!]! hasMore: Boolean! }
type GlossaryCandidate { sourceId: ID! sourceVersion: Int!  name: String! abbreviation: String! before: String! after: String! beforeTruncated: Boolean! afterTruncated: Boolean! start: Int! end: Int! }
type RequirementGlossary { version: Int! matches: [GlossaryMatch!]! candidates: [GlossaryCandidate!]! }
